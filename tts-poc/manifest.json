{
  "manifest_version": 3,
  "name": "Voice To Text",
  "version": "1.0",
  "description": "Speech to text converter with keyboard shortcuts",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "content.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Toggle voice recording"
    }
  }
}
