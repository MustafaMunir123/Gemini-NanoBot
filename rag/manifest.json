{
    "manifest_version": 3,
    "name": "Gemini Nano RAG Assistant",
    "version": "1.0",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "128": "icon.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab"
    ],
    "host_permissions": [
        "https://cdn.jsdelivr.net/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}