{
  "manifest_version": 3,
  "name": "Sound on Click",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "web_accessible_resources": [{
    "resources": ["sound.mp3"],
    "matches": ["<all_urls>"]
  }]
}
